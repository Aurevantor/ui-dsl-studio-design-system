{
  "$description": "特定 Component 専用。Semantic を alias する（docs/04 §1）。部品の側は chrome.* を直接読まず、ここを経由する —— 「Pane の面を 1 段上げる」を Token 1 件の付け替えで言えるようにするため。",
  "eyebrow": {
    "color": { "$type": "color", "$value": "{chrome.chalkDim}" },
    "typography": { "$type": "typography", "$value": "{chrome.type.eyebrow}" }
  },
  "rule": {
    "color": { "$type": "color", "$value": "{chrome.ruleSoft}" },
    "thickness": { "$type": "dimension", "$value": "{chrome.stroke.hairline}" }
  },
  "pane": {
    "background": { "$type": "color", "$value": "{chrome.mat}" },
    "raisedBackground": { "$type": "color", "$value": "{chrome.matRaise}" },
    "border": { "$type": "color", "$value": "{chrome.rule}" },
    "borderWidth": { "$type": "dimension", "$value": "{chrome.stroke.hairline}" },
    "radius": { "$type": "dimension", "$value": "{chrome.radius.pane}" },
    "padding": { "$type": "dimension", "$value": "{chrome.space.md}" },
    "spacing": { "$type": "dimension", "$value": "{chrome.space.sm}" }
  },
  "problem": {
    "$description": "診断 1 行（Diagnostics の見本）。severity は色ではなく種別が軸（#79）—— studio.css は error/warning だけ色を変え、info は既定の chalkDim のまま（packages/compiler/src/diagnostics.ts の Severity が持つ非対称をそのまま引き継ぐ）。",
    "infoColor": { "$type": "color", "$value": "{chrome.chalkDim}" },
    "warningColor": { "$type": "color", "$value": "{chrome.amber}" },
    "errorColor": { "$type": "color", "$value": "{chrome.alert}" },
    "barWidth": { "$type": "dimension", "$value": "{chrome.size.problemBar}" },
    "gap": { "$type": "dimension", "$value": "{chrome.space.md}" },
    "messageGap": { "$type": "dimension", "$value": "{chrome.space.xs}" },
    "codeTypography": { "$type": "typography", "$value": "{chrome.type.mono}" },
    "messageTypography": { "$type": "typography", "$value": "{chrome.type.body}" },
    "messageColor": { "$type": "color", "$value": "{chrome.chalk}" },
    "whereTypography": { "$type": "typography", "$value": "{chrome.type.mono}" },
    "whereColor": { "$type": "color", "$value": "{chrome.chalkDim}" }
  },
  "filesItem": {
    "$description": "Files ペインの木の 1 行（`.files__item`）。実測（#153・#155）で State を持つ 4 種の 1 つ。既定は文字だけ chalk、hover / selected は面だけを上げる（新しい色を足さない・.files__item[aria-current='true'] の規律どおり）。selected は aria-current 相当の持続する状態なので、State 名は pressed ではなく独自名にする（#156 と揃える・pressed だと state-css.ts が :active を出し、押している間だけ変わる別物になる）。",
    "color": { "$type": "color", "$value": "{chrome.chalk}" },
    "typography": { "$type": "typography", "$value": "{chrome.type.mono}" },
    "hoverBackground": { "$type": "color", "$value": "{chrome.ruleSoft}" },
    "selectedBackground": { "$type": "color", "$value": "{chrome.rule}" },
    "paddingHorizontal": { "$type": "dimension", "$value": "{chrome.space.md}" },
    "paddingVertical": { "$type": "dimension", "$value": "{chrome.space.xs}" }
  },
  "gauge": {
    "$description": "コンパイル定規（.gauge）の見本。対数目盛は本来 left:% で置くが、カンプに <ForEach> も算術も無いので Grid の等分列で近似する（#155）。ここで決めるのは刻みの色・高さ・ラベルの字組みだけ。",
    "value": { "$type": "color", "$value": "{chrome.chalk}" },
    "valueUnit": { "$type": "color", "$value": "{chrome.chalkDim}" },
    "valueTypography": { "$type": "typography", "$value": "{chrome.type.gaugeValue}" },
    "tickColor": { "$type": "color", "$value": "{chrome.rule}" },
    "tickLimitColor": { "$type": "color", "$value": "{chrome.alert}" },
    "tickWidth": { "$type": "dimension", "$value": "{chrome.stroke.hairline}" },
    "tickHeight": { "$type": "dimension", "$value": "{chrome.space.sm}" },
    "tickHeightLimit": { "$type": "dimension", "$value": "{chrome.space.md}" },
    "labelColor": { "$type": "color", "$value": "{chrome.chalkDim}" },
    "labelLimitColor": { "$type": "color", "$value": "{chrome.alert}" },
    "noteColor": { "$type": "color", "$value": "{chrome.chalkDim}" }
  }
}
