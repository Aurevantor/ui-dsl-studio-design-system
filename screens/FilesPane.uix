<!-- studio-design: FilesPane
     omitted: グループの中身は Prop に配列型が無く ForEach が使えないので、実在する
     ファイル名を手で並べた（要るのは縦の律動だけ）。「Project を追加」「削除」は
     App の殻で開いたときだけ出る（ブラウザでは出ない）が、ここでは出ている側を描く。
     Toggle の「入り」（選んだ Project / 開いているファイル）は画面から固定できないので
     描かず、Inspector の強制表示で見る。

     Files ペイン（.files）の 2 段。左が Projects の一覧（.files__project）、右が
     Project を選んだあとの木（.files__back → .files__workspace → .files__group）。
     行は FilesItem / ProjectItem で、どちらも名前とパスの 2 行。 -->
<Screen id="files-pane" name="FilesPane" background="$chrome.mat">

    <ScrollView width="fill" height="fill">

        <HStack
            id="files-body"
            padding="$chrome.space.screen"
            spacing="$chrome.space.screen"
            align="start">

            <VStack
                id="files-projects"
                width="240"
                borderColor="$chrome.rule"
                borderWidth="$chrome.stroke.hairline"
                align="stretch">
                <HStack
                    spacing="$chrome.space.sm"
                    padding-horizontal="$chrome.space.pane"
                    padding-vertical="$chrome.space.sm"
                    align="baseline">
                    <Eyebrow label="FILES" />
                    <Text style="$chrome.type.paneNote" color="$chrome.chalkDim">ui-dsl-studio-design-system</Text>
                </HStack>
                <Rule color="$chrome.ruleSoft" />
                <VStack
                    padding-horizontal="$filesItem.inset"
                    padding-vertical="$chrome.space.sm"
                    spacing="$chrome.space.xs"
                    align="stretch">
                    <HStack align="center">
                        <Eyebrow label="PROJECTS" />
                        <Spacer />
                        <Toggle label="Project を追加" />
                    </HStack>
                    <VStack spacing="$chrome.space.tight" align="stretch">
                        <ProjectItem name="ui-dsl-studio-design-system" root="~/src/ui-dsl-studio-design-system" />
                        <ProjectItem name="hello-world" root="../../examples/hello-world" />
                        <ProjectItem name="apple-design-system" root="~/src/apple-design-system" />
                    </VStack>
                    <Eyebrow label="登録したフォルダ" />
                    <HStack spacing="$chrome.space.xs" padding-horizontal="$filesItem.paddingHorizontal" align="center">
                        <Text style="$filesItem.pathTypography" color="$filesItem.pathColor">~/src/ui-dsl-studio-design-system</Text>
                        <Spacer />
                        <HStack shrink="0">
                            <Toggle label="削除" />
                        </HStack>
                    </HStack>
                </VStack>
            </VStack>

            <VStack
                id="files-tree"
                width="240"
                borderColor="$chrome.rule"
                borderWidth="$chrome.stroke.hairline"
                align="stretch">
                <HStack
                    spacing="$chrome.space.sm"
                    padding-horizontal="$chrome.space.pane"
                    padding-vertical="$chrome.space.sm"
                    align="baseline">
                    <Eyebrow label="FILES" />
                    <Text style="$chrome.type.paneNote" color="$chrome.chalkDim">ui-dsl-studio-design-system</Text>
                </HStack>
                <Rule color="$chrome.ruleSoft" />
                <VStack
                    padding-horizontal="$filesItem.inset"
                    padding-vertical="$chrome.space.sm"
                    spacing="$chrome.space.xs"
                    align="stretch">
                    <HStack align="center">
                        <Toggle label="← Projects" />
                        <Spacer />
                    </HStack>
                    <VStack spacing="$chrome.space.tight" padding-horizontal="$filesItem.paddingHorizontal" align="stretch">
                        <Text style="$chrome.type.mono" color="$chrome.chalk">ui-dsl-studio-design-system</Text>
                        <Text style="$chrome.type.filesRoot" color="$chrome.chalkDim">~/src/ui-dsl-studio-design-system</Text>
                    </VStack>
                    <Eyebrow label="SCREENS" />
                    <VStack spacing="$chrome.space.tight" align="stretch">
                        <FilesItem label="Shell.uix" path="screens/Shell.uix" />
                        <FilesItem label="FilesPane.uix" path="screens/FilesPane.uix" held="編集中（外部の保存を保留）" />
                        <FilesItem label="Titlebar.uix" path="screens/Titlebar.uix" />
                    </VStack>
                    <Eyebrow label="COMPONENTS" />
                    <VStack spacing="$chrome.space.tight" align="stretch">
                        <FilesItem label="Eyebrow.uix" path="components/Eyebrow.uix" />
                        <FilesItem label="Toggle.uix" path="components/Toggle.uix" />
                    </VStack>
                    <Eyebrow label="TOKENS" />
                    <VStack spacing="$chrome.space.tight" align="stretch">
                        <FilesItem label="component.tokens.json" path="tokens/component.tokens.json" />
                    </VStack>
                    <Eyebrow label="FIXTURES" />
                    <Text style="$chrome.type.emptyNote" color="$chrome.chalkDim">（0 件）</Text>
                </VStack>
            </VStack>

            <Spacer />

        </HStack>

    </ScrollView>

</Screen>

<Aside
    id="files-pane-aside"
    spacing="$chrome.space.md"
    padding="$aside.padding"
    background="$aside.background"
    radius="$aside.radius"
    align="stretch">

    <VStack spacing="$aside.spacing" align="stretch">
        <Text style="$aside.labelTypography" color="$aside.labelColor">UI DSL STUDIO — FILES</Text>
        <Text id="cover-title" style="$chrome.type.title" color="$chrome.chalk">
            ファイル
        </Text>
        <Text id="cover-note" style="$chrome.type.body" color="$chrome.chalkDim">
            左ペインは 2 段。最初は Projects の一覧で、1 つ選ぶと木に替わる。
            木は Project の下に Screens / Components / Tokens / Fixtures が並び、
            空のグループも消さずに（0 件）と出す（tree.ts）。
        </Text>
    </VStack>

</Aside>
