<!-- studio-design: Shell
     omitted: 各ペインの中身は代表の数行だけで、実寸の判断は部位図（Titlebar / Gauge /
     FilesPane / EditorPane / PreviewPane / InspectorPane / DiagnosticsPane）が持つ。
     この画面が決めるのは構図と階調 ―― どこに罫が入り、どの面が一段上がり、ペインが
     どの比で並ぶか。定規の帯は高さと軸線だけ（Gauge.uix の担当）。Preview の中身は
     白い矩形 1 つで、方眼・デバイスの飾り・選択枠は描かない（PreviewPane.uix の担当）。
     仕切りは掴めない（v0.1 は表示専用）ので、比は panes.ts の DEFAULT_LAYOUT の写しを
     1 例だけ置く。Toggle 群の初期選択は実装の既定に合わせて selected="true" で描く。
     hover / focused の見た目と、タイトルバー・操作バーの折り返しは省く。
     Bottom View On の構図は ShellBottomOn.uix、Flow モードは FlowMode.uix が持つ。

     ## この画面は既定の状態 ―― Bottom View Off

     新しいワークスペースは Bottom View Off で開く（view-store.ts の bottomViewEnabled:
     false）。下段の Diagnostics は畳まれ、窓の底に StatusBar が 1 行だけ出る。

     ## 構図は Canvas First

     上段は `Files 220 │ Preview（残り）│ Workbench 500`。Preview が残りを取り、
     右の Workbench は Editor と Inspector を 3:2 で縦に積む（studio.css の .stage）。
     列を分けるのは仕切り、Editor と Inspector の間は強い罫（.stage__inspector の
     border-top）。

     ## 階調 ―― 作業面は 1 枚、上がるのは操作群だけ

     ペインはどれも同じ作業面に載り、分けるのは罫と仕切り。一段上がる（matRaise）のは
     浮くもの（補完・吹き出し）と操作群（ToggleGroup：Design / Flow、Device など）と
     Flow の notice だけ。 -->
<Screen id="shell" name="Shell" background="$chrome.mat">

    <VStack
        id="shell-body"
        width="fill"
        height="fill"
        padding="$chrome.space.screen"
        align="stretch">

        <VStack
            id="shell-window"
            width="fill"
            height="fill"
            borderColor="$chrome.rule"
            borderWidth="$chrome.stroke.hairline"
            radius="$chrome.radius.pane"
            clip="true"
            align="stretch">

            <!-- 帯 1: タイトルバー。名前 → Design / Flow → ファイル → 未保存と保存、右寄せで
                 uix dev と件数。下は強い罫。 -->
            <HStack
                id="shell-titlebar"
                width="fill"
                spacing="$chrome.space.lg"
                padding-horizontal="$chrome.space.lg"
                padding-vertical="$chrome.space.sm"
                align="center">
                <Text style="$chrome.type.mark" color="$chrome.chalk">UI DSL Studio</Text>
                <ToggleGroup>
                    <Toggle label="Design" selected="true" />
                    <Toggle label="Flow" />
                </ToggleGroup>
                <Text style="$chrome.type.mono" color="$chrome.chalk">screens/Shell.uix</Text>
                <Text style="$chrome.type.meta" color="$chrome.amber">未保存</Text>
                <Toggle label="保存 ⌘S" />
                <Toggle label="破棄" />
                <Spacer />
                <Text style="$chrome.type.link" color="$chrome.chalkDim">uix dev push #3</Text>
                <Text style="$chrome.type.meta" color="$chrome.chalkDim">
                    184 IR nodes 62 tokens
                </Text>
            </HStack>

            <Rule color="$chrome.rule" />

            <!-- 帯 2: コンパイル定規。 -->
            <HStack
                id="shell-gauge"
                width="fill"
                spacing="$chrome.space.lg"
                padding-horizontal="$chrome.space.lg"
                padding-vertical="$chrome.space.sm"
                align="center">
                <Eyebrow label="COMPILE" />
                <HStack spacing="$chrome.space.xs" shrink="0" align="baseline">
                    <Text style="$chrome.type.gaugeValue" color="$chrome.chalk">0.42</Text>
                    <Text style="$chrome.type.gaugeUnit" color="$chrome.chalkDim">ms</Text>
                </HStack>
                <Rule color="$chrome.rule" />
            </HStack>

            <Rule color="$chrome.rule" />

            <!-- 上段: Files | Preview | Workbench。Preview が残りを取る。 -->
            <HStack id="shell-stage" width="fill" grow="1" align="stretch">

                <VStack id="pane-files" width="220" align="stretch">
                    <HStack
                        spacing="$chrome.space.sm"
                        padding-horizontal="$chrome.space.pane"
                        padding-vertical="$chrome.space.sm"
                        align="baseline">
                        <Eyebrow label="FILES" />
                        <Text style="$chrome.type.paneNote" color="$chrome.chalkDim">
                            ui-dsl-studio-design-system
                        </Text>
                    </HStack>
                    <Rule color="$chrome.ruleSoft" />
                    <VStack
                        padding-horizontal="$filesItem.inset"
                        padding-vertical="$chrome.space.xs"
                        spacing="$chrome.space.tight"
                        align="stretch">
                        <Eyebrow label="SCREENS" />
                        <FilesItem label="Shell.uix" path="screens/Shell.uix" selected="true" />
                        <FilesItem label="Titlebar.uix" path="screens/Titlebar.uix" />
                        <Eyebrow label="COMPONENTS" />
                        <FilesItem label="Toggle.uix" path="components/Toggle.uix" />
                    </VStack>
                </VStack>

                <Splitter axis="vertical" />

                <VStack id="pane-preview" width="fill" align="stretch">
                    <HStack
                        spacing="$chrome.space.sm"
                        padding-horizontal="$chrome.space.pane"
                        padding-vertical="$chrome.space.sm"
                        align="baseline">
                        <Eyebrow label="PREVIEW" />
                        <Text style="$chrome.type.paneNote" color="$chrome.chalkDim">Shell.uix</Text>
                    </HStack>
                    <Rule color="$chrome.ruleSoft" />
                    <!-- 操作バー。群は一段上げた面（ToggleGroup）。 -->
                    <HStack
                        spacing="$chrome.space.sm"
                        padding-horizontal="$chrome.space.pane"
                        padding-vertical="$chrome.space.xs"
                        align="center">
                        <ToggleGroup>
                            <Toggle label="iPhone" />
                            <Toggle label="iPad" />
                            <Toggle label="Mac" selected="true" />
                            <Toggle label="Web" />
                        </ToggleGroup>
                        <ToggleGroup>
                            <Toggle label="Light" selected="true" />
                            <Toggle label="Dark" />
                        </ToggleGroup>
                        <ToggleGroup>
                            <Toggle label="−" />
                            <Toggle label="100%" />
                            <Toggle label="+" />
                            <Toggle label="Fit" selected="true" />
                        </ToggleGroup>
                        <Spacer />
                    </HStack>
                    <Rule color="$chrome.ruleSoft" />
                    <VStack
                        width="fill"
                        grow="1"
                        padding="$chrome.space.md"
                        align="center"
                        justify="center">
                        <VStack
                            id="preview-standin"
                            width="320"
                            height="200"
                            background="$chrome.specimenLight"
                            radius="$chrome.radius.window"
                            borderColor="$chrome.hairline"
                            borderWidth="$chrome.stroke.hairline"
                            shadow="$chrome.shadow.device" />
                    </VStack>
                </VStack>

                <Splitter axis="vertical" />

                <!-- Workbench: Editor 3 : Inspector 2。間は強い罫。 -->
                <VStack id="pane-workbench" width="500" align="stretch">

                    <VStack id="pane-editor" width="fill" grow="3" align="stretch">
                        <HStack
                            spacing="$chrome.space.sm"
                            padding-horizontal="$chrome.space.pane"
                            padding-vertical="$chrome.space.sm"
                            align="baseline">
                            <Eyebrow label="UIX EDITOR" />
                        </HStack>
                        <Rule color="$chrome.ruleSoft" />
                        <VStack
                            padding-horizontal="$chrome.space.sm"
                            padding-vertical="$chrome.space.sm"
                            align="stretch">
                            <HStack width="fill" spacing="$chrome.space.sm" align="stretch">
                                <HStack width="$chrome.size.gutter">
                                    <Spacer />
                                    <Text style="$chrome.type.code" color="$chrome.chalkDim">1</Text>
                                </HStack>
                                <Text style="$chrome.type.code" color="$chrome.chalk">
                                    &lt;Screen id="shell" name="Shell"&gt;
                                </Text>
                            </HStack>
                            <HStack width="fill" spacing="$chrome.space.sm" align="stretch">
                                <HStack width="$chrome.size.gutter">
                                    <Spacer />
                                    <Text style="$chrome.type.code" color="$chrome.chalkDim">2</Text>
                                </HStack>
                                <VStack width="$chrome.size.indent" />
                                <Text style="$chrome.type.code" color="$chrome.chalk">
                                    &lt;HStack grow="1"&gt;
                                </Text>
                            </HStack>
                        </VStack>
                    </VStack>

                    <Rule color="$chrome.rule" />

                    <VStack id="pane-inspector" width="fill" grow="2" align="stretch">
                        <HStack
                            spacing="$chrome.space.sm"
                            padding-horizontal="$chrome.space.pane"
                            padding-vertical="$chrome.space.sm"
                            align="baseline">
                            <Eyebrow label="INSPECTOR" />
                            <Text style="$chrome.type.paneNote" color="$chrome.chalkDim">(read-only)</Text>
                        </HStack>
                        <Rule color="$chrome.ruleSoft" />
                        <VStack
                            padding-horizontal="$chrome.space.pane"
                            padding-vertical="$chrome.space.sm"
                            spacing="$chrome.space.xs"
                            align="stretch">
                            <HStack spacing="$chrome.space.sm" align="baseline">
                                <Eyebrow label="SELECTED" />
                                <Text style="$chrome.type.mono" color="$chrome.chalk">HStack</Text>
                                <Text style="$chrome.type.link" color="$chrome.chalkDim">定義へ</Text>
                            </HStack>
                            <HStack spacing="$chrome.space.sm" align="baseline">
                                <Eyebrow label="PROJECT" />
                                <Text style="$chrome.type.mono" color="$chrome.chalk">
                                    ui-dsl-studio-design-system
                                </Text>
                            </HStack>
                            <HStack spacing="$chrome.space.sm" align="baseline">
                                <Eyebrow label="FILE" />
                                <Text style="$chrome.type.mono" color="$chrome.chalk">
                                    screens/Shell.uix
                                </Text>
                            </HStack>
                        </VStack>
                    </VStack>

                </VStack>

            </HStack>

            <!-- Bottom View Off: Diagnostics の代わりに StatusBar 1 行。上は強い罫。 -->
            <Rule color="$chrome.rule" />
            <StatusBar
                diagnostics="2"
                project="ui-dsl-studio-design-system"
                file="screens/Shell.uix" />

        </VStack>

    </VStack>

</Screen>

<Aside
    id="shell-aside"
    spacing="$chrome.space.md"
    padding="$aside.padding"
    background="$aside.background"
    radius="$aside.radius"
    align="stretch">

    <VStack spacing="$aside.spacing" align="stretch">
        <Text style="$aside.labelTypography" color="$aside.labelColor">UI DSL STUDIO — SHELL</Text>
        <Text id="cover-title" style="$chrome.type.title" color="$chrome.chalk">
            ぜんたい（既定・Bottom View Off）
        </Text>
        <Text id="cover-note" style="$chrome.type.body" color="$chrome.chalkDim">
            Canvas First の 1 枚。Preview が中央で残りを取り、右の Workbench に
            Editor と Inspector を積む。Diagnostics は既定で畳まれ、底の StatusBar に件数だけが出る。
        </Text>
    </VStack>

    <VStack spacing="$aside.spacing" align="stretch">
        <Text style="$aside.labelTypography" color="$aside.labelColor">RULES — 2 段</Text>
        <Text style="$chrome.type.body" color="$chrome.chalkDim">
            強いほうは窓を横断する帯の境目と、Workbench の Editor / Inspector の境目に入る。
            弱いほうはペインの中（見出しの下・操作バーの下）を分ける。
        </Text>
        <VStack spacing="$chrome.space.xs" align="stretch">
            <Rule color="$chrome.rule" />
            <Text style="$chrome.type.mono" color="$chrome.chalkDim">
                rule — タイトルバーの下・定規の下・Inspector の上・StatusBar の上
            </Text>
        </VStack>
        <VStack spacing="$chrome.space.xs" align="stretch">
            <Rule color="$chrome.ruleSoft" />
            <Text style="$chrome.type.mono" color="$chrome.chalkDim">
                ruleSoft — ペインの見出しの下・操作バーの下
            </Text>
        </VStack>
    </VStack>

    <VStack spacing="$aside.spacing" align="stretch">
        <Text style="$aside.labelTypography" color="$aside.labelColor">SPLITTER — 6PT</Text>
        <Text style="$chrome.type.body" color="$chrome.chalkDim">
            列を分けるのは仕切り（Files | Preview | Workbench の 2 本）。State は
            normal / hover / focused の 3 つで、Inspector から強制表示できる。
        </Text>
        <Splitter axis="horizontal" />
        <Text style="$chrome.type.mono" color="$chrome.chalkDim">
            芯 2pt + 輪 2pt × 2 = 6pt。安静時の輪は地と同色で、焦点で chalk に変わる
        </Text>
    </VStack>

</Aside>
